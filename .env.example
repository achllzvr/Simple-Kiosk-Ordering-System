APP_NAME="Kiosk Ordering"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# XAMPP often uses 3306 or 3308 — match MySQL in phpMyAdmin / my.cnf
DB_PORT=3306
DB_DATABASE=kiosk_ordering
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# PayMongo Hosted Checkout v2 (test keys from https://dashboard.paymongo.com)
# PAYMONGO_WEBHOOK_SECRET is required outside local/testing (signature verification).
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,paymaya,qrph
